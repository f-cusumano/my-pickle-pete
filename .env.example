# Copia questo file in .env (escluso da git) e adatta i valori: valgono solo per avvia.bat
# JDK 25 da usare per il backend
JAVA_HOME=C:\Program Files\Java\jdk-25
# Porta HTTP (default 8080)
#MPP_PORT=8080
# 0.0.0.0 per raggiungere l'app dal telefono in rete locale (default 127.0.0.1)
#MPP_SERVER_ADDRESS=0.0.0.0
# Browser da aprire (default brave)
#MPP_BROWSER=brave
