# Copia questo file in .env (escluso da git) e adatta i valori: valgono solo per avvia.bat
# JDK 25 da usare per il backend (se manca o non è valido avvia.bat lo cerca nelle cartelle più comuni)
JAVA_HOME=C:\Development\Java\jdk-25.0.2
# Porta HTTP (default 8080)
#MPP_PORT=8080
# 0.0.0.0 per raggiungere l'app dal telefono in rete locale (default 127.0.0.1)
#MPP_SERVER_ADDRESS=0.0.0.0
# Browser da aprire (default brave)
#MPP_BROWSER=brave
# Password iniziali delle utenze create al primo avvio (usate solo finché non ne hanno una, poi si cambiano dal Profilo)
#MPP_ADMIN_PASSWORD=
#MPP_OWNER_PASSWORD=
# Chiave che firma il cookie "Ricordami": senza, il cookie vale solo fino al riavvio del backend
#MPP_REMEMBER_ME_KEY=
# Solo per le release (profilo prod, SPRING_PROFILES_ACTIVE=prod): PostgreSQL al posto del file H2
#MPP_DB_URL=jdbc:postgresql://localhost:5432/mpp
#MPP_DB_USERNAME=mpp
#MPP_DB_PASSWORD=
# Solo per il porting una tantum (SPRING_PROFILES_ACTIVE=prod,porting): file H2 da copiare, senza estensione
#MPP_PORTING_H2_PATH=C:\Progetti\Privati\my-pickle-pete\backend\data\my-pickle-pete
